# Public domain for the dashboard, API and node connections (DNS must point here)
INFERA_DOMAIN=beta.example.com
# Testers need this code to sign up
INFERA_INVITE_CODE=change-me
# Protects the payout and credit admin endpoints
INFERA_ADMIN_TOKEN=change-me-long-random
# Owner share of each job's price
INFERA_OWNER_SHARE=0.70
# Free credits for each new developer account (USD)
INFERA_STARTER_CREDITS_USD=5
# Default prices, USD per 1M tokens
INFERA_PRICE_IN=0.10
INFERA_PRICE_OUT=0.30
# Optional per-model prices, JSON
# INFERA_PRICES={"qwen3.5-2b":{"in":0.05,"out":0.15}}
# Optional fallback provider (OpenAI-compatible) used when no device is free
# INFERA_FALLBACK_URL=https://api.together.xyz/v1
# INFERA_FALLBACK_KEY=
# INFERA_FALLBACK_MODEL=Qwen/Qwen3-8B
